# Read access to 3Dconnexion SpaceMice for non-root users.
# Install: sudo cp 99-spacemouse.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="hidraw*", ATTRS{idVendor}=="256f", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="256f", MODE="0666", GROUP="plugdev"
# Older devices sold under the Logitech vendor ID (046d:c6xx).
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c6??", MODE="0666", GROUP="plugdev"
